# Copy this file to .env and fill in real values before running docker compose.

# Django
DJANGO_SECRET_KEY=change-me-to-a-long-random-string
DJANGO_DEBUG=false
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,web

# Postgres
POSTGRES_DB=interceptor
POSTGRES_USER=interceptor
POSTGRES_PASSWORD=change-me

# Redis / Celery
REDIS_URL=redis://redis:6379/0

# Shared secret the mitmproxy addon uses to authenticate to the Django API
# (flow ingestion + fetching custom headers to inject). Must match between
# the web/worker containers and the proxy container.
INGEST_TOKEN=change-me-to-a-long-random-string
INGEST_URL=http://web:8000/api/flows/ingest/
HEADERS_URL=http://web:8000/api/custom-headers/

# Bootstrap admin account, created automatically on first startup if no
# superuser exists yet. Change the password after first login.
ADMIN_USERNAME=admin
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=change-me
